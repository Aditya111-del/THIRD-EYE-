# THIRD EYE — AI-Native Terminal Workspace Environment Template
# Copy this file to .env and configure your keys

# Google Gemini API Key (Primary AI Provider for THIRD EYE Terminal Diagnostics)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Active AI Provider: 'gemini' | 'openai'
AI_PROVIDER=gemini

# Optional: OpenAI Configuration (Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Microservices Ports
PTY_SERVICE_PORT=4001
AI_SERVICE_PORT=4002
SALESFORCE_SERVICE_PORT=4003

# Salesforce Integration
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_API_KEY=
SALESFORCE_USER_EMAIL=
SALESFORCE_CLIENT_ID=

# Dev Server Port
VITE_DEV_SERVER_URL=http://localhost:3000

# Environment
NODE_ENV=development
